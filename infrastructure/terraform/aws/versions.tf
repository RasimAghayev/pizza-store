terraform {
  required_version = ">= 1.17.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }

  # No backend block: this skeleton is validated-only (Issue #160). A real deployment
  # would configure an S3 + DynamoDB (or S3 native locking, provider >= 5.70) backend here.
}
