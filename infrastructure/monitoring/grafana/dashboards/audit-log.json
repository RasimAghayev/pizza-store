{
  "title": "Audit Log",
  "uid": "pizza-audit-log",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Postgres / MongoDB connection and DDL events",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=~\"postgres|mongodb\"} |~ \"(?i)connection authorized|disconnection|statement: (CREATE|ALTER|DROP)|successfully authenticated|connection accepted|connection ended|checking authorization\"",
          "refId": "A"
        }
      ]
    }
  ]
}
