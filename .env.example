POSTGRES_DB=pizza_store
POSTGRES_USER=pizza_store
POSTGRES_PORT=5432

MONGO_INITDB_ROOT_USERNAME=pizza_store
MONGO_PORT=27017

REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=pizza_store
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

NGINX_HTTP_PORT=80

BACKEND_PORT=8000

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
POSTGRES_EXPORTER_PORT=9187
MONGODB_EXPORTER_PORT=9216
REDIS_EXPORTER_PORT=9121
RABBITMQ_PROMETHEUS_PORT=15692
LOKI_PORT=3100
JAEGER_UI_PORT=16686
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
ALERTMANAGER_PORT=9093

# Documented exception to the file-based-secret convention (see
# docs/security/secret-management.md): percona/mongodb_exporter is a scratch-based
# single-binary image with no shell and no password-file flag, so this one credential
# is delivered via Compose variable interpolation instead of a secrets:-mounted file.
MONGODB_EXPORTER_PASSWORD=changeme-local-dev-only

# Frontend origin(s) allowed to call the backend API with credentials (ADR 0006) --
# comma-separated, never "*" (CORS_ALLOW_CREDENTIALS=True forbids pairing with a wildcard
# origin). Placeholder port until Phase 7 fixes the real frontend dev server port.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
