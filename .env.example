# Docker Compose reads this special variable itself (not application code) to decide which
# `profiles:`-gated services to start -- "observability" activates the Phase 4 monitoring/
# logging/tracing/alerting stack (Issue #157). Kept on by default so local dev/CI behavior is
# unchanged from before profiles existed; a real VPS deployment can override this to an empty
# value to run leaner.
COMPOSE_PROFILES=observability

POSTGRES_DB=pizza_store
POSTGRES_USER=pizza_store
POSTGRES_PORT=5432

MONGO_INITDB_ROOT_USERNAME=pizza_store
MONGO_PORT=27017

REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=pizza_store
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

NGINX_HTTP_PORT=80
# Only read when infrastructure/compose/docker-compose.prod.yml is also passed via -f
# (Issue #157) -- the base compose file's nginx service does not expose this port.
NGINX_HTTPS_PORT=443

BACKEND_PORT=8000

# Only read by docker-compose.prod.yml's certbot service (Issue #157) -- a real, publicly
# DNS-resolving domain and a real mailbox Let's Encrypt can reach about certificate problems.
# CERTBOT_STAGING_FLAG defaults to Let's Encrypt's staging CA so a misconfigured run never
# burns real-CA rate limits by accident -- set to an empty string for a genuine production
# issuance. See docs/deployment/vps.md's SSL section.
CERTBOT_DOMAIN=changeme.example.com
CERTBOT_EMAIL=changeme@example.com
CERTBOT_STAGING_FLAG=--staging

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
POSTGRES_EXPORTER_PORT=9187
MONGODB_EXPORTER_PORT=9216
REDIS_EXPORTER_PORT=9121
RABBITMQ_PROMETHEUS_PORT=15692
LOKI_PORT=3100
JAEGER_UI_PORT=16686
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
ALERTMANAGER_PORT=9093

# Documented exception to the file-based-secret convention (see
# docs/security/secret-management.md): percona/mongodb_exporter is a scratch-based
# single-binary image with no shell and no password-file flag, so this one credential
# is delivered via Compose variable interpolation instead of a secrets:-mounted file.
MONGODB_EXPORTER_PASSWORD=changeme-local-dev-only

# Frontend origin(s) allowed to call the backend API with credentials (ADR 0006) --
# comma-separated, never "*" (CORS_ALLOW_CREDENTIALS=True forbids pairing with a wildcard
# origin). Placeholder port until Phase 7 fixes the real frontend dev server port.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Social login OAuth client IDs (Issue #178) -- not confidential (embedded in every
# client-side OAuth request already), so plain env vars rather than Compose secrets; the
# matching App Secret for Facebook only lives in
# infrastructure/compose/secrets/facebook_app_secret.txt instead (see that file's .example).
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_ID=
